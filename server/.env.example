APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=data/app.sqlite
S3_ENDPOINT=http://127.0.0.1:9000
# Optional: address reachable by the phone when it differs from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://YOUR_MAC_LAN_IP:9000
# Optional: storage address reachable by the local dashboard browser when it differs from the phone address.
# S3_DASHBOARD_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=upload-video
S3_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-with-random-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-local-secret
STORAGE_BIND_IP=127.0.0.1
# Optional local face detector; install the Python package and models first.
# FACE_MODEL_DIR=data/models
# FACE_PYTHON=data/face-venv/bin/python3
# Face research is disabled by default. Set only to the dedicated invited study account.
# FACE_RESEARCH_ACCOUNT_ID=account-id
# Consent-based local trial only. Requires APP_ENV=development; never set on Fly.
# FACE_RESEARCH_LOCAL_TRIAL=1
# Production is configured by fly.toml and Fly's Tigris secrets:
# AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, BUCKET_NAME.

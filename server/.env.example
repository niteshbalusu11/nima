APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=data/app.sqlite
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=upload-video
S3_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-with-random-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-local-secret
STORAGE_BIND_IP=127.0.0.1
# Production: APP_ENV=production, S3_REGION=auto, S3_PATH_STYLE=false,
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# API_DOMAIN is used by the production HTTPS proxy, not the iOS runtime.
API_DOMAIN=localhost
